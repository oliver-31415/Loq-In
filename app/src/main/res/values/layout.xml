<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Runtime-applied only on inconsistent API-34+ framework images. -->
    <style name="SwitchlyApi34FrameworkCompatOverlay">
        <!--
            Some Android 14 system images report API 34 while missing TextView.setLineHeight(int, float).
            AppCompat 1.7+ preserves the original text dimension unit and therefore reaches that framework overload while inflating.

            Route common Material typography through line-height-free AppCompat appearances only on the detected broken framework.
            Normal Android builds keep the regular Material typography because this overlay is never applied there.
        -->
        <item name="textAppearanceLineHeightEnabled">false</item>
        <item name="textAppearanceBody1">@style/Switchly.Api34SafeText.Body1</item>
        <item name="textAppearanceBody2">@style/Switchly.Api34SafeText.Body2</item>
        <item name="textAppearanceCaption">@style/Switchly.Api34SafeText.Caption</item>
        <item name="textAppearanceButton">@style/Switchly.Api34SafeText.Button</item>
        <item name="textAppearanceHeadline6">@style/Switchly.Api34SafeText.Title</item>
        <item name="textAppearanceSubtitle1">@style/Switchly.Api34SafeText.Subhead</item>
        <item name="textAppearanceSubtitle2">@style/Switchly.Api34SafeText.Body2</item>

        <item name="textAppearanceBodyLarge">@style/Switchly.Api34SafeText.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/Switchly.Api34SafeText.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/Switchly.Api34SafeText.BodySmall</item>
        <item name="textAppearanceLabelMedium">@style/Switchly.Api34SafeText.LabelMedium</item>
        <item name="textAppearanceTitleLarge">@style/Switchly.Api34SafeText.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/Switchly.Api34SafeText.TitleMedium</item>
        <item name="textAppearanceHeadlineLarge">@style/Switchly.Api34SafeText.HeadlineLarge</item>
    </style>

    <!--
        Explicitly avoid the platform android:lineHeight attribute. The compat
        lineHeight attribute is cleared instead, which keeps minSdk 27 lint-clean
        and prevents AppCompat from selecting the API-34 unit-aware framework path.
    -->
    <style name="Switchly.Api34SafeText.Body1" parent="TextAppearance.AppCompat.Body1">
        <item name="lineHeight">@null</item>
    </style>

    <style name="Switchly.Api34SafeText.Body2" parent="TextAppearance.AppCompat.Body2">
        <item name="lineHeight">@null</item>
    </style>

    <style name="Switchly.Api34SafeText.Caption" parent="TextAppearance.AppCompat.Caption">
        <item name="lineHeight">@null</item>
    </style>

    <style name="Switchly.Api34SafeText.Button" parent="TextAppearance.AppCompat.Button">
        <item name="lineHeight">@null</item>
    </style>

    <style name="Switchly.Api34SafeText.Title" parent="TextAppearance.AppCompat.Title">
        <item name="lineHeight">@null</item>
    </style>

    <style name="Switchly.Api34SafeText.Subhead" parent="TextAppearance.AppCompat.Subhead">
        <item name="lineHeight">@null</item>
    </style>

    <style name="Switchly.Api34SafeText.BodyLarge" parent="Switchly.Api34SafeText.Body1">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Switchly.Api34SafeText.BodyMedium" parent="Switchly.Api34SafeText.Body2">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Switchly.Api34SafeText.BodySmall" parent="Switchly.Api34SafeText.Caption">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Switchly.Api34SafeText.LabelMedium" parent="Switchly.Api34SafeText.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Switchly.Api34SafeText.TitleLarge" parent="Switchly.Api34SafeText.Title">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Switchly.Api34SafeText.TitleMedium" parent="Switchly.Api34SafeText.Subhead">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Switchly.Api34SafeText.HeadlineLarge" parent="Switchly.Api34SafeText.Title">
        <item name="android:textSize">32sp</item>
    </style>

    <!-- =========================
         THEME: Blocker variant
         ========================= -->
    <!-- Variant without ActionBar (overlay/blocker screens) -->
    <!-- Fully opaque, no edge-to-edge; used e.g. for BlockerActivity -->
    <style name="Theme.Switchly.Blocker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.Switchly.None</item>
    </style>

    <style name="Animation.Switchly.None" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/switchly_no_animation</item>
        <item name="android:activityOpenExitAnimation">@anim/switchly_no_animation</item>
        <item name="android:activityCloseEnterAnimation">@anim/switchly_no_animation</item>
        <item name="android:activityCloseExitAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskOpenEnterAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskOpenExitAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskCloseEnterAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskCloseExitAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskToFrontEnterAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskToFrontExitAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskToBackEnterAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskToBackExitAnimation">@anim/switchly_no_animation</item>
    </style>

    <!-- =========================
         COMPONENT STYLES: Toolbar/buttons/cards/chips
         ========================= -->
    <!-- Unified top bar, uses current accent color -->
    <style name="Switchly.TopBar" parent="Widget.MaterialComponents.Toolbar">
        <!-- Background = current accent color -->
        <item name="android:background">?attr/colorPrimary</item>
        <item name="backgroundTint">?attr/colorPrimary</item>

        <!-- Title color -->
        <item name="titleTextColor">@android:color/white</item>

        <!-- Back arrow in light/dark appearance -->
        <item name="navigationIconTint">@android:color/white</item>
    </style>

    <!-- Standard buttons -->
    <style name="Switchly.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <!-- Primary button alias -->
    <style name="Switchly.PrimaryButton" parent="Switchly.Button" />

    <style name="Switchly.OutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Switchly.OutlinedButton.CompactSegment" parent="Switchly.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Lightweight dialog/action buttons (no filled background) -->
    <style name="Switchly.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Floating Action Button -->
    <style name="Switchly.Fab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">@android:color/white</item>
    </style>

    <!-- Card shape appearance -->
    <style name="ShapeAppearance.Switchly.Card" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>

    <!-- Even rounder tiles (quick actions) -->
    <style name="ShapeAppearance.Switchly.Tile" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">30dp</item>
    </style>

    <style name="Switchly.Card" parent="Widget.MaterialComponents.CardView">
        <item name="shapeAppearance">@style/ShapeAppearance.Switchly.Card</item>
        <item name="cardBackgroundColor">@color/switchly_card_bg</item>
        <item name="strokeColor">@color/switchly_card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <!-- Tile cards in the dashboard quick actions -->
    <style name="Switchly.TileCard" parent="Switchly.Card">
        <item name="shapeAppearance">@style/ShapeAppearance.Switchly.Tile</item>
        <item name="cardElevation">1dp</item>
    </style>

    <style name="Switchly.SectionHeader">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Small divider inside cards -->
    <style name="Switchly.Divider" parent="Widget.MaterialComponents.MaterialDivider">
        <item name="dividerColor">@color/switchly_divider</item>
        <item name="dividerThickness">1dp</item>
    </style>
    <!-- Small badges -->
    <style name="Switchly.Chip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/switchly_divider</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Small tile badge -->
    <style name="Switchly.TileBadge">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:minHeight">18dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Day picker chips -->
    <style name="Switchly.DayChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipCornerRadius">999dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="chipStartPadding">9dp</item>
        <item name="chipEndPadding">9dp</item>
        <item name="textStartPadding">2dp</item>
        <item name="textEndPadding">2dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- =========================
         DROPDOWNS: TextInputLayout
         ========================= -->
    <!-- Default (non-dropdown) TextInputLayout styling used globally via theme -->
    <style name="Switchly.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Default (non-dropdown) AutoCompleteTextView styling used globally via theme -->
    <style name="Switchly.AutoCompleteText" parent="Widget.MaterialComponents.AutoCompleteTextView.OutlinedBox">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBody1</item>
    </style>

    <!-- Layout container for exposed dropdown menus -->
    <style name="Switchly.DropdownLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintEnabled">true</item>
        <item name="hintTextAppearance">@style/Switchly.DropdownHint</item>
    </style>

    <!-- Hint text styling inside dropdowns -->
    <style name="Switchly.DropdownHint" parent="TextAppearance.MaterialComponents.Body2">
    </style>

    <!-- Text appearance for dropdown input field -->
    <style name="Switchly.DropdownText" parent="Widget.MaterialComponents.AutoCompleteTextView.OutlinedBox">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBody1</item>
    </style>

</resources>
