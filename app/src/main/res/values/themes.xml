<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =========================
         THEME: Base + compatibility alias
         ========================= -->
    <!-- Backwards-compatible alias (older builds referenced @style/Switchly as the app theme) -->
    <style name="Switchly" parent="Theme.Switchly" />

    <!-- Base application theme (day/default) -->
    <style name="Theme.Switchly" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Accent/primary colors -->
        <item name="colorPrimary">@color/accent_default_green</item>
        <item name="colorPrimaryVariant">@color/accent_default_green</item>
        <item name="colorSecondary">@color/accent_default_green</item>

        <!-- Status bar -->
        <item name="android:windowLightStatusBar">true</item>

        <!-- Explicit typography mapping for classic MaterialComponents theme.
             Layouts reference these attrs so the API-34 compatibility overlay can replace only typography on malformed frameworks without changing normal text colors/contrast. 
             Keep normal devices visually identical to the original explicit MaterialComponents/Material3 appearances. -->
        <item name="textAppearanceBody1">@style/TextAppearance.MaterialComponents.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.MaterialComponents.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.MaterialComponents.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.MaterialComponents.Button</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.MaterialComponents.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.MaterialComponents.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.MaterialComponents.Subtitle2</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Material3.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Material3.BodySmall</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Material3.LabelMedium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Material3.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Material3.TitleMedium</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Material3.HeadlineLarge</item>

        <!-- Global Material component styles -->
        <item name="materialButtonStyle">@style/Switchly.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Switchly.OutlinedButton</item>
        <item name="floatingActionButtonStyle">@style/Switchly.Fab</item>
        <item name="materialCardViewStyle">@style/Switchly.Card</item>

        <!-- Toolbar/ActionBar -->
        <item name="toolbarStyle">@style/Switchly.TopBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.MaterialComponents.ActionBar</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.MaterialComponents.Light</item>
        <item name="android:textColorPrimaryInverse">@android:color/white</item>

        <!--
            IMPORTANT:
            Do NOT apply the ExposedDropdownMenu TextInputLayout style globally.
            It causes crashes when a normal EditText is placed inside a TextInputLayout (Material requires an AutoCompleteTextView for exposed dropdowns).
            Use Switchly.DropdownLayout only on actual dropdown fields in XML.
        -->
        <item name="textInputStyle">@style/Switchly.TextInputLayout</item>
        <item name="autoCompleteTextViewStyle">@style/Switchly.AutoCompleteText</item>

        <!-- Dialog overlay -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Switchly.Dialog</item>
    </style>

    <!-- Dialog overlay that keeps controls in sync with the current accent theme. -->
    <style name="ThemeOverlay.Switchly.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlHighlight">?attr/colorPrimary</item>
        <item name="colorAccent">?attr/colorPrimary</item>
    </style>

    <!-- =========================
         THEME: Accent variants
         ========================= -->
