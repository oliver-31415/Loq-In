<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode status bar icons. NOTE: this file REPLACES values/themes.xml
         entries of the same style name at night — so it must repeat the full
         per-accent colorPrimary set, or every ?attr/colorPrimary widget (FAB,
         outlined buttons, chips) falls back to the green Base at night. -->
    <style name="Theme.Switchly" parent="Theme.Switchly.Base">
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/accent_default_green</item>
        <item name="colorPrimaryVariant">@color/accent_default_green</item>
        <item name="colorSecondary">@color/accent_default_green</item>
        <item name="colorAccent">@color/accent_default_green</item>
        <item name="colorControlActivated">@color/accent_default_green</item>
        <item name="colorPrimaryContainer">@color/accent_green_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_green_on_container</item>
        <item name="colorSecondaryContainer">@color/accent_green_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_green_on_container</item>
    </style>

