<?xml version="1.0" encoding="utf-8"?>
<!-- A row inside a code-built ListGroupLayout: icon, title + summary, trailing slot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/LoqIn.ListRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true">

    <ImageView
        android:id="@+id/rowIcon"
        style="@style/LoqIn.RowIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null" />

    <LinearLayout
        style="@style/LoqIn.RowText"
        android:layout_width="0dp"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/rowTitle"
            style="@style/LoqIn.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Mixed mode" />

        <TextView
            android:id="@+id/rowSummary"
            style="@style/LoqIn.RowSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="Manual button plus the channels you allow"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowTrailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal" />
</LinearLayout>
