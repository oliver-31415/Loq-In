<?xml version="1.0" encoding="utf-8"?>
<!--
    Quick Settings / widget shortcut tile: the shared flat square tile (as grid_stat_tile.xml),
    readable-accent icon, label and an optional top-right badge (added / opens Android's flow).
-->
<com.oliver.loqin.ui.SquareCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tileRoot"
    style="@style/LoqIn.StatTile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTileIcon"
                style="@style/LoqIn.StatIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvTileLabel"
                style="@style/LoqIn.StatLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="3"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivTileBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:contentDescription="@null"
            android:src="@drawable/check_circle_24"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />
    </FrameLayout>
</com.oliver.loqin.ui.SquareCardView>
