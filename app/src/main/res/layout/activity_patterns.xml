<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/LoqIn.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="@string/patterns_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        style="@style/LoqIn.PageContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/scopeToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScopeDistracting"
                    style="@style/LoqIn.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/patterns_scope_distracting" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScopeAll"
                    style="@style/LoqIn.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/patterns_scope_all" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/allowModeNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/patterns_allow_mode_note"
                android:paddingStart="@dimen/row_padding_start"
                android:paddingEnd="@dimen/row_padding_start"
                android:textAppearance="@style/TextAppearance.LoqIn.RowSummary"
                android:visibility="gone" />

            <com.oliver.loqin.ui.widgets.EmptyStateView
                android:id="@+id/cardEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/block_gap"
                android:visibility="gone"
                app:emptyIcon="@drawable/bar_chart_24"
                app:emptyTitle="@string/patterns_empty_title" />

            <LinearLayout
                android:id="@+id/contentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/LoqIn.PageCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/block_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/page_card_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/patterns_heatmap_title"
                            android:textAppearance="@style/TextAppearance.LoqIn.RowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/patterns_heatmap_desc"
                            android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />

                        <com.oliver.loqin.ui.widgets.HourHeatmapView
                            android:id="@+id/heatmap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:contentDescription="@string/patterns_heatmap_description" />

                        <TextView
                            android:id="@+id/peakText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textAppearance="@style/TextAppearance.LoqIn.Default"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heatmapMarksNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/patterns_heatmap_marks_note"
                            android:textAppearance="@style/TextAppearance.LoqIn.StatLabel"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/LoqIn.PageCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/block_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/page_card_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/patterns_pickup_title"
                            android:textAppearance="@style/TextAppearance.LoqIn.RowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/patterns_pickup_desc"
                            android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />

                        <com.oliver.loqin.ui.widgets.DotStripChartView
                            android:id="@+id/pickupChart"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:layout_marginTop="16dp"
                            android:contentDescription="@string/patterns_pickup_description" />

                        <TextView
                            android:id="@+id/pickupAverage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textAppearance="@style/TextAppearance.LoqIn.Default"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/LoqIn.PageCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/block_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/page_card_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/patterns_protection_title"
                            android:textAppearance="@style/TextAppearance.LoqIn.RowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/patterns_protection_desc"
                            android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />

                        <com.oliver.loqin.ui.widgets.ProtectedBarsView
                            android:id="@+id/protectionChart"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:layout_marginTop="16dp"
                            android:contentDescription="@string/patterns_protection_description" />

                        <TextView
                            android:id="@+id/legendProtected"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/patterns_legend_protected"
                            android:textAppearance="@style/TextAppearance.LoqIn.StatLabel" />

                        <TextView
                            android:id="@+id/legendUnprotected"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/patterns_legend_unprotected"
                            android:textAppearance="@style/TextAppearance.LoqIn.StatLabel" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
