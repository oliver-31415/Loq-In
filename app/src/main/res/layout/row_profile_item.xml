<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardProfile"
    style="@style/LoqIn.PageCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        style="@style/LoqIn.ListRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/viewActiveBar"
            android:layout_width="4dp"
            android:layout_height="42dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/colorPrimary"
            android:visibility="gone" />

        <ImageView
            style="@style/LoqIn.RowIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/switch_account_24" />

        <LinearLayout
            style="@style/LoqIn.RowText"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvName"
                style="@style/LoqIn.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_label_default" />

            <TextView
                android:id="@+id/tvSubtitle"
                style="@style/LoqIn.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_row_subtitle" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvActiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/row_trailing_gap"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:text="@string/state_profile_on_status"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivProfileActionState"
            android:layout_width="@dimen/row_icon_size"
            android:layout_height="@dimen/row_icon_size"
            android:layout_marginStart="@dimen/row_trailing_gap"
            android:contentDescription="@string/edit"
            android:src="@drawable/edit_24"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
