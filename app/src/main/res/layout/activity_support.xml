<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Topbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Switchly.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="@string/support_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Switchly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/support_hero_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:textColor="@color/switchly_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/support_desc"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/switchly_text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenEmail"
                        style="@style/Switchly.PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:minHeight="52dp"
                        android:text="@string/support_open_email"
                        app:icon="@drawable/send_24"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/support_response_time_short"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/switchly_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Switchly.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:text="@string/support_diagnostics_section" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Switchly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowViewLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="82dp"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivViewLogs"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/list_alt_24"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/tvViewLogsTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="@string/support_logs_unified_title"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/ivViewLogsChevron"
                            app:layout_constraintStart_toEndOf="@id/ivViewLogs"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="3dp"
                            android:text="@string/support_logs_unified_desc"
                            android:textColor="@color/switchly_text_secondary"
                            android:textSize="12sp"
                            android:maxLines="2"
                            app:layout_constraintEnd_toStartOf="@id/ivViewLogsChevron"
                            app:layout_constraintStart_toEndOf="@id/ivViewLogs"
                            app:layout_constraintTop_toBottomOf="@id/tvViewLogsTitle" />

                        <ImageView
                            android:id="@+id/ivViewLogsChevron"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:alpha="0.7"
                            android:contentDescription="@string/open"
                            android:src="@drawable/keyboard_arrow_right_24"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/switchly_text_secondary" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Switchly.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:text="@string/support_contact_section" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Switchly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowSupportEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="76dp"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivSupportEmail"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/mail_24"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/tvSupportEmailLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="@string/support_email_label"
                            android:textColor="@color/switchly_text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@id/btnCopyEmailInline"
                            app:layout_constraintStart_toEndOf="@id/ivSupportEmail"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvSupportEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="3dp"
                            android:text="@string/about_mail_address"
                            android:textColor="@color/contact_text"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            app:layout_constraintEnd_toStartOf="@id/btnCopyEmailInline"
                            app:layout_constraintStart_toEndOf="@id/ivSupportEmail"
                            app:layout_constraintTop_toBottomOf="@id/tvSupportEmailLabel" />

                        <ImageButton
                            android:id="@+id/btnCopyEmailInline"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:padding="10dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/support_copy_email"
                            android:src="@drawable/content_copy_24"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorOnSurface" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.google.android.material.divider.MaterialDivider
                        style="@style/Switchly.Divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="54dp"
                        android:layout_marginEnd="12dp" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowSupportDiscord"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="76dp"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivSupportDiscord"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/discord_24"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvSupportDiscordLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="@string/support_discord_label"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            app:layout_constraintEnd_toStartOf="@id/btnCopyDiscordInline"
                            app:layout_constraintStart_toEndOf="@id/ivSupportDiscord"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvSupportDiscordUrl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/switchly_text_secondary"
                            android:textSize="13sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            app:layout_constraintEnd_toStartOf="@id/btnCopyDiscordInline"
                            app:layout_constraintStart_toEndOf="@id/ivSupportDiscord"
                            app:layout_constraintTop_toBottomOf="@id/tvSupportDiscordLabel" />

                        <ImageButton
                            android:id="@+id/btnCopyDiscordInline"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:padding="10dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/support_copy_discord"
                            android:src="@drawable/content_copy_24"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorOnSurface" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.google.android.material.divider.MaterialDivider
                        style="@style/Switchly.Divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="54dp"
                        android:layout_marginEnd="12dp" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowSupportGitLabIssues"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="76dp"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivSupportGitLabIssues"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/gitlab_24"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvSupportGitLabIssuesLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="@string/support_gitlab_issues_label"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            app:layout_constraintEnd_toStartOf="@id/btnCopyGitLabIssuesInline"
                            app:layout_constraintStart_toEndOf="@id/ivSupportGitLabIssues"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvSupportGitLabIssuesUrl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/switchly_text_secondary"
                            android:textSize="13sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            app:layout_constraintEnd_toStartOf="@id/btnCopyGitLabIssuesInline"
                            app:layout_constraintStart_toEndOf="@id/ivSupportGitLabIssues"
                            app:layout_constraintTop_toBottomOf="@id/tvSupportGitLabIssuesLabel" />

                        <ImageButton
                            android:id="@+id/btnCopyGitLabIssuesInline"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:padding="10dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/support_copy_gitlab_issues"
                            android:src="@drawable/content_copy_24"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorOnSurface" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
