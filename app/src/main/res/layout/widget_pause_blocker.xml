<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetPauseRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_card_bg">

    <TextView
        android:id="@+id/widgetPauseHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:text="@string/widget_pause_blocker_name"
        android:textColor="@color/foqos_on_surface"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:drawablePadding="8dp" />

    <LinearLayout
        android:id="@+id/widgetPauseGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widgetPauseRowTop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widgetPause5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/pause_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/widget_breaks_5"
                android:textColor="@color/foqos_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widgetPause15"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:background="@drawable/pause_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/widget_pause_15"
                android:textColor="@color/foqos_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widgetPauseRowBottom"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widgetPause30"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/pause_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/widget_pause_30"
                android:textColor="@color/foqos_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widgetPause60"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:background="@drawable/pause_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/widget_pause_60"
                android:textColor="@color/foqos_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
