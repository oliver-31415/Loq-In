<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Headers sit flush with the fields: the sheet owns the side padding. -->

    <TextView
        android:id="@+id/tvStatsDropdownPrimaryLabel"
        style="@style/LoqIn.SectionHeader.First"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="@string/stats_section_filter" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/LoqIn.SheetField.Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:endIconMode="dropdown_menu"
        app:startIconDrawable="@drawable/tune_24">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            style="@style/LoqIn.SheetDropdownText"
            android:id="@+id/dropdownStatsPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:inputType="none"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvStatsDropdownSortLabel"
        style="@style/LoqIn.SectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="@string/stats_sort_title" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/LoqIn.SheetField.Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:endIconMode="dropdown_menu"
        app:startIconDrawable="@drawable/sort_24">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            style="@style/LoqIn.SheetDropdownText"
            android:id="@+id/dropdownStatsSort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:inputType="none"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>

    <CheckBox
        android:id="@+id/cbStatsExtraFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_gap"
        android:minHeight="@dimen/touch_target"
        android:visibility="gone" />
</LinearLayout>
