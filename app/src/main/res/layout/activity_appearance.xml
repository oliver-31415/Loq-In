<?xml version="1.0" encoding="utf-8"?>
<!--
    Appearance.

    Choice settings use segmented bars (the same MaterialButtonToggleGroup +
    SegmentedToggleUi treatment as the insights range selector): a single
    track with the selected option highlighted. The theme colour is an inline
    selector in the same group: a grid of swatches. Controls start at the row
    text column (icon 24dp + gap 16dp = 40dp), so they line up with the title.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/LoqIn.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="@string/settings_theme_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAppearance"
        style="@style/LoqIn.PageContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.oliver.loqin.ui.widgets.ListGroupLayout
                style="@style/LoqIn.ListGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_first_gap">

                <!-- Display mode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/row_padding_start"
                    android:paddingTop="@dimen/row_padding_vertical"
                    android:paddingEnd="@dimen/row_padding_end"
                    android:paddingBottom="@dimen/row_padding_vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/LoqIn.RowIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/toggle_on_24" />

                        <LinearLayout
                            style="@style/LoqIn.RowText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content">

                            <TextView
                                style="@style/LoqIn.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/pref_theme_mode_title" />

                            <TextView
                                android:id="@+id/tvThemeModeSummary"
                                style="@style/LoqIn.RowSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleThemeMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:layout_marginTop="12dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnThemeSystem"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pref_theme_mode_system_short" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnThemeLight"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pref_theme_mode_light" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnThemeDark"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pref_theme_mode_dark" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>


                <!-- Time format -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/row_padding_start"
                    android:paddingTop="@dimen/row_padding_vertical"
                    android:paddingEnd="@dimen/row_padding_end"
                    android:paddingBottom="@dimen/row_padding_vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/LoqIn.RowIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/schedule_24" />

                        <LinearLayout
                            style="@style/LoqIn.RowText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content">

                            <TextView
                                style="@style/LoqIn.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/pref_time_format_title" />

                            <TextView
                                android:id="@+id/tvTimeFormatSummary"
                                style="@style/LoqIn.RowSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleTimeFormat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:layout_marginTop="12dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTimeAutomatic"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pref_time_format_system_short" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTime24"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pref_time_format_24h" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTime12"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pref_time_format_12h" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>


                <!-- Theme color: header and an inline swatch grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/row_padding_start"
                    android:paddingTop="@dimen/row_padding_vertical"
                    android:paddingEnd="@dimen/row_padding_end"
                    android:paddingBottom="@dimen/row_padding_vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/LoqIn.RowIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/palette_24" />

                        <LinearLayout
                            style="@style/LoqIn.RowText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content">

                            <TextView
                                style="@style/LoqIn.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/pref_theme_color_title" />

                            <TextView
                                android:id="@+id/tvThemeColorSummary"
                                style="@style/LoqIn.RowSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <GridLayout
                        android:id="@+id/gridAccentSwatches"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:layout_marginTop="12dp"
                        android:columnCount="5" />
                </LinearLayout>


                <!-- Language -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/row_padding_start"
                    android:paddingTop="@dimen/row_padding_vertical"
                    android:paddingEnd="@dimen/row_padding_end"
                    android:paddingBottom="@dimen/row_padding_vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/LoqIn.RowIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/translate_24" />

                        <LinearLayout
                            style="@style/LoqIn.RowText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content">

                            <TextView
                                style="@style/LoqIn.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/pref_language_title" />

                            <TextView
                                android:id="@+id/tvLanguageSummary"
                                style="@style/LoqIn.RowSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:layout_marginTop="12dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLanguageSystem"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pref_theme_mode_system_short" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLanguageEnglish"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pref_language_english" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLanguageGerman"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pref_language_german" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.oliver.loqin.ui.widgets.ListGroupLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
