<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_card_bg"
    tools:ignore="UseCompoundDrawables">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_toggle_off_20" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/widget_pause_blocker_name"
            android:textColor="@color/foqos_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:background="@drawable/widget_tile_bg"
        android:text="@string/widget_pause_15"
        android:textColor="@color/foqos_on_surface"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:background="@drawable/widget_tile_bg"
        android:text="@string/widget_pause_30"
        android:textColor="@color/foqos_on_surface"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:background="@drawable/widget_tile_bg"
        android:text="@string/widget_pause_60"
        android:textColor="@color/foqos_on_surface"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
