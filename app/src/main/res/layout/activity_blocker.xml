<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/blocker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/loqin_bg"
    tools:ignore="Overdraw">

    <!-- Why this is blocked (profile, rule): top end, out of the way. -->
    <ImageButton
        android:id="@+id/blocker_debug_info"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:contentDescription="@string/block_reason_info_button_desc"
        android:src="@drawable/info_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Content: the blocked app's icon with a lock on a soft blob, what's blocked and why. -->
    <ScrollView
        android:id="@+id/blocker_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/blocker_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blocker_debug_info">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <FrameLayout
                android:id="@+id/blocker_icon_stage"
                android:layout_width="240dp"
                android:layout_height="200dp">

                <View
                    android:id="@+id/blocker_blob"
                    android:layout_width="220dp"
                    android:layout_height="190dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:rotation="-12" />

                <FrameLayout
                    android:layout_width="116dp"
                    android:layout_height="116dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/blocker_app_icon"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:importantForAccessibility="no"
                        android:padding="16dp" />

                    <ImageView
                        android:id="@+id/blocker_lock_badge"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="bottom|end"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:src="@drawable/lock_24" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/blocker_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:text="@string/blocked_app_default"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/blocker_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:visibility="gone"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/blocker_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/blocked_message"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/blocker_attempts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:minHeight="32dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/blocker_focus_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/blocker_reason_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Leaving is the big thumb-reach action; a break is a quiet, limited second choice. -->
    <LinearLayout
        android:id="@+id/blocker_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="420dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close"
            style="@style/LoqIn.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/close"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_blocker_break"
            style="@style/LoqIn.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:visibility="gone"
            app:icon="@drawable/timer_24"
            app:iconGravity="textStart" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
