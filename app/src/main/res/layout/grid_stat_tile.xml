<?xml version="1.0" encoding="utf-8"?>
<!--
    Loq In Stats tile (style LoqIn.StatTile): flat square page card, accent icon,
    accent number, muted label. No stroke, no shadow.
-->
<com.oliver.loqin.ui.SquareCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/statTileRoot"
    style="@style/LoqIn.StatTile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/ivStatIcon"
            style="@style/LoqIn.StatIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvStatValue"
            style="@style/LoqIn.StatValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvStatLabel"
            style="@style/LoqIn.StatLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</com.oliver.loqin.ui.SquareCardView>
