<?xml version="1.0" encoding="utf-8"?>
<!-- One saved barcode: a flat page card holding a shared list row (icon, name, code). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LoqIn.PageCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        style="@style/LoqIn.ListRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivIcon"
            style="@style/LoqIn.RowIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/barcode_24" />

        <LinearLayout
            style="@style/LoqIn.RowText"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvName"
                style="@style/LoqIn.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvRaw"
                style="@style/LoqIn.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvMeta"
                style="@style/LoqIn.RowStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAction"
                style="@style/LoqIn.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2" />
        </LinearLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/row_trailing_gap"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
