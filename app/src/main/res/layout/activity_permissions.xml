<?xml version="1.0" encoding="utf-8"?>
<!--
    Permissions & Reliability.

    Layout mirrors the onboarding setup pages: a scrolling column of full-width
    setup cards grouped under flat section headers. The cards themselves are built
    in code via SetupCardRow so this screen and onboarding share one component.
    Section containers keep stable ids because deep links (EXTRA_FOCUS_SECTION /
    EXTRA_FOCUS_TARGET) and the "issues" toolbar action scroll to them.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/LoqIn.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="@string/pref_permissions_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/permissionsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Core -->
            <TextView
                android:id="@+id/sectionCore"
                style="@style/LoqIn.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="2dp"
                android:text="@string/permissions_section_core" />

            <LinearLayout
                android:id="@+id/cardsCore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Notifications -->
            <TextView
                android:id="@+id/sectionNotifications"
                style="@style/LoqIn.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="2dp"
                android:text="@string/permissions_section_notifications" />

            <LinearLayout
                android:id="@+id/cardsNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Schedule triggers -->
            <TextView
                android:id="@+id/sectionTriggers"
                style="@style/LoqIn.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="2dp"
                android:text="@string/permissions_section_triggers" />

            <LinearLayout
                android:id="@+id/cardsTriggers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Battery & background -->
            <TextView
                android:id="@+id/sectionBattery"
                style="@style/LoqIn.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="2dp"
                android:text="@string/permissions_section_battery" />

            <LinearLayout
                android:id="@+id/cardsBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- OEM autostart / background restrictions (only shown on aggressive OEMs) -->
            <LinearLayout
                android:id="@+id/groupAutostart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/sectionAutostart"
                    style="@style/LoqIn.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="2dp"
                    android:text="@string/permissions_section_oem" />

                <LinearLayout
                    android:id="@+id/cardsAutostart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
