<?xml version="1.0" encoding="utf-8"?>
<!--
    Permissions & Reliability.

    Section headers over grouped lists, like the rest of Settings. The rows are built in
    code (PermissionRow, the shared row anatomy with a status line). Section containers keep
    stable ids because deep links (EXTRA_FOCUS_SECTION / EXTRA_FOCUS_TARGET) and the "issues"
    toolbar action scroll to them.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/LoqIn.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="@string/pref_permissions_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/permissionsScroll"
        style="@style/LoqIn.PageContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Core -->
            <TextView
                android:id="@+id/sectionCore"
                style="@style/LoqIn.SectionHeader.First"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permissions_section_core" />

            <com.oliver.loqin.ui.widgets.ListGroupLayout
                android:id="@+id/cardsCore"
                style="@style/LoqIn.ListGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Notifications -->
            <TextView
                android:id="@+id/sectionNotifications"
                style="@style/LoqIn.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permissions_section_notifications" />

            <com.oliver.loqin.ui.widgets.ListGroupLayout
                android:id="@+id/cardsNotifications"
                style="@style/LoqIn.ListGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Schedule triggers -->
            <TextView
                android:id="@+id/sectionTriggers"
                style="@style/LoqIn.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permissions_section_triggers" />

            <com.oliver.loqin.ui.widgets.ListGroupLayout
                android:id="@+id/cardsTriggers"
                style="@style/LoqIn.ListGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Battery & background -->
            <TextView
                android:id="@+id/sectionBattery"
                style="@style/LoqIn.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permissions_section_battery" />

            <com.oliver.loqin.ui.widgets.ListGroupLayout
                android:id="@+id/cardsBattery"
                style="@style/LoqIn.ListGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- OEM autostart / background restrictions (only shown on aggressive OEMs) -->
            <LinearLayout
                android:id="@+id/groupAutostart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/sectionAutostart"
                    style="@style/LoqIn.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permissions_section_oem" />

                <com.oliver.loqin.ui.widgets.ListGroupLayout
                    android:id="@+id/cardsAutostart"
                    style="@style/LoqIn.ListGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
