<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tempSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top drag handle -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_sheet_grab_handle" />

    <!-- Header: Accent roundel + titles + close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/roundelBg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_roundel_accent">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:srcCompat="@drawable/timer_24"
                app:tint="?attr/colorPrimary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nfc_action_temp_disable"
                android:textColor="?attr/colorOnSurface"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:text="@string/dashboard_temp_sheet_sub_disable"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_roundel_neutral">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cancel"
                app:srcCompat="@drawable/close_24"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>
    </LinearLayout>

    <!-- Active Timer Card (shown only when a timer is currently active) -->
    <LinearLayout
        android:id="@+id/cardActiveTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dotActiveTimer"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_round_dot" />

            <TextView
                android:id="@+id/tvActiveTimerBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/tile_temp_title_plain"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="24m 15s left" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelTimer"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:text="@string/dashboard_temp_sheet_cancel_timer"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Presets Section -->
    <LinearLayout
        android:id="@+id/layoutPresetsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK PRESETS"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:alpha="0.55"
            android:layout_marginBottom="8dp" />

        <!-- Row 1: 5 min, 15 min -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/preset5m"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="min"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:alpha="0.65" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/preset15m"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="min"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:alpha="0.65" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: 30 min, 1 hr -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/preset30m"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="min"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:alpha="0.65" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/preset60m"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="hour"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:alpha="0.65" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- More Options Section -->
    <LinearLayout
        android:id="@+id/layoutMoreOptionsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MORE OPTIONS"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:alpha="0.55"
            android:layout_marginBottom="8dp" />

        <!-- Custom Duration Row -->
        <LinearLayout
            android:id="@+id/rowCustomDuration"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/roundelCustom"
                android:layout_width="32dp"
                android:layout_height="32dp">

                <ImageView
                    android:id="@+id/ivCustomIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/edit_24" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/custom_minutes"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:text="@string/minutes_hint"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:alpha="0.4"
                android:contentDescription="@null"
                app:srcCompat="@drawable/keyboard_arrow_right_24"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Pause Until Row (visible when mode == DISABLE) -->
        <LinearLayout
            android:id="@+id/rowPauseUntil"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/roundelPauseUntil"
                android:layout_width="32dp"
                android:layout_height="32dp">

                <ImageView
                    android:id="@+id/ivPauseUntilIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/schedule_24" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPauseUntilTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_pause_until_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPauseUntilSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:text="@string/dashboard_pause_until_tomorrow"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:alpha="0.4"
                android:contentDescription="@null"
                app:srcCompat="@drawable/keyboard_arrow_right_24"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>
    </LinearLayout>

    <!-- Locked Warning Card (visible when locked by NFC or active timer lock) -->
    <LinearLayout
        android:id="@+id/cardLockedNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivLockedIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/lock_24"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvLockedNotice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:alpha="0.8"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Footer Note -->
    <TextView
        android:id="@+id/tvNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:alpha="0.5"
        android:text="@string/nfc_temp_hint_timer_behavior"
        android:textColor="?attr/colorOnSurface"
        android:textSize="11.5sp" />
</LinearLayout>
