<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tempSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="22dp">

    <!-- Grab handle + title + close, as in every Home sheet (sheet_header.xml) -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_grab_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nfc_action_temp_disable"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                style="@style/LoqIn.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_temp_sheet_sub_disable" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_sheet_close"
            android:clickable="true"
            android:contentDescription="@string/close"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/close_24"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>
    </LinearLayout>

    <!-- What today's break limits allow, as on the Breaks page; breaks only. -->
    <TextView
        android:id="@+id/tvLimitStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:drawablePadding="12dp"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textAppearance="@style/TextAppearance.LoqIn.RowSummary"
        android:visibility="gone" />

    <!-- Active Timer Card (shown only when a timer is currently active) -->
    <LinearLayout
        android:id="@+id/cardActiveTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dotActiveTimer"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_round_dot" />

            <TextView
                android:id="@+id/tvActiveTimerBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/tile_temp_title_plain"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="24m 15s left" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelTimer"
            style="@style/LoqIn.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dashboard_temp_sheet_cancel_timer" />
    </LinearLayout>

    <!-- Quick Presets Section -->
    <LinearLayout
        android:id="@+id/layoutPresetsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            style="@style/LoqIn.SectionHeader.First"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/temp_duration_quick_presets" />

        <!-- Row 1: 5 min, 15 min -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/preset5m"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minHeight="64dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    tools:ignore="HardcodedText"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/temp_pause_unit_minutes"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:alpha="0.65" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/preset15m"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minHeight="64dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15"
                    tools:ignore="HardcodedText"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/temp_pause_unit_minutes"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:alpha="0.65" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: 30 min, 1 hr -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tile_gap"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/preset30m"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minHeight="64dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30"
                    tools:ignore="HardcodedText"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/temp_pause_unit_minutes"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:alpha="0.65" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/preset60m"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minHeight="64dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    tools:ignore="HardcodedText"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/temp_duration_unit_hour"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:alpha="0.65" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- More Options Section -->
    <LinearLayout
        android:id="@+id/layoutMoreOptionsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/LoqIn.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/temp_duration_more_options" />

        <com.oliver.loqin.ui.widgets.ListGroupLayout
            style="@style/LoqIn.ListGroup.OnSurface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/rowCustomDuration"
            style="@style/LoqIn.ListRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivCustomIcon"
                style="@style/LoqIn.RowIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/edit_24" />

            <LinearLayout
                style="@style/LoqIn.RowText"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/LoqIn.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/custom_minutes" />

                <TextView
                    android:id="@+id/tvCustomSubtitle"
                    style="@style/LoqIn.RowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/minutes_hint" />
            </LinearLayout>

            <ImageView
                style="@style/LoqIn.RowChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Pause Until Row (visible when mode == DISABLE) -->
        <LinearLayout
            android:id="@+id/rowPauseUntil"
            style="@style/LoqIn.ListRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivPauseUntilIcon"
                style="@style/LoqIn.RowIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/schedule_24" />

            <LinearLayout
                style="@style/LoqIn.RowText"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvPauseUntilTitle"
                    style="@style/LoqIn.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_pause_until_title" />

                <TextView
                    android:id="@+id/tvPauseUntilSubtitle"
                    style="@style/LoqIn.RowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ImageView
                style="@style/LoqIn.RowChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />
        </LinearLayout>
        </com.oliver.loqin.ui.widgets.ListGroupLayout>
    </LinearLayout>

    <!-- Locked Warning Card (visible when locked by NFC or active timer lock) -->
    <LinearLayout
        android:id="@+id/cardLockedNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivLockedIcon"
            android:layout_width="@dimen/row_icon_size"
            android:layout_height="@dimen/row_icon_size"
            android:contentDescription="@null"
            app:srcCompat="@drawable/lock_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tvLockedNotice"
            style="@style/LoqIn.RowSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/row_icon_gap"
            android:layout_marginTop="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Footer Note -->
    <TextView
        android:id="@+id/tvNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/nfc_temp_hint_timer_behavior"
        android:textAppearance="@style/TextAppearance.LoqIn.StatLabel" />
</LinearLayout>
