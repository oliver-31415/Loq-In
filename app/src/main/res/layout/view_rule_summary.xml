<?xml version="1.0" encoding="utf-8"?>
<!-- Summary card at the top of a rule page (schedules, breaks): icon roundel, headline, detail.
     A LoqIn.PageCard, so it lines up with the groups under it; the host sets the page margins. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ruleSummaryCard"
    style="@style/LoqIn.PageCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/page_card_padding">

        <ImageView
            android:id="@+id/ruleSummaryIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_roundel_accent"
            android:importantForAccessibility="no"
            android:padding="11dp"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/row_icon_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ruleSummaryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ruleSummaryDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/LoqIn.RowSummary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
