<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/LoqIn.PageCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/tile_gap"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/row_min_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/row_padding_start"
        android:paddingTop="@dimen/row_padding_vertical"
        android:paddingEnd="@dimen/row_padding_end"
        android:paddingBottom="@dimen/row_padding_vertical">

        <ImageView
            android:id="@+id/imgIcon"
            android:layout_width="@dimen/stats_app_icon_size"
            android:layout_height="@dimen/stats_app_icon_size"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <LinearLayout
            style="@style/LoqIn.RowText"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LoqIn.RowTitle"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.LoqIn.RowSummary"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.LoqIn.RowSummary"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone"
            app:buttonTint="?attr/colorPrimary"
            app:useMaterialThemeColors="false" />

        <ImageView
            android:id="@+id/imgMore"
            style="@style/LoqIn.RowChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
