<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Topbar: in an AppBarLayout with fitsSystemWindows like every page, which is what
         EdgeToEdgeUtils.setupClassic expects for the status-bar inset -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarLocationMapPicker"
            style="@style/LoqIn.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="@string/schedules_location_map_picker_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/locationMapPickerContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/page_top_padding"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvMapPickerBody"
            android:textAppearance="@style/TextAppearance.LoqIn.RowSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/schedules_location_map_picker_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutMapLocationQuery"
            style="@style/LoqIn.SearchField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/schedules_location_picker_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMapPickerBody"
            app:helperText="@string/schedules_location_picker_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputMapLocationQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:imeOptions="actionSearch" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMapPickerSearch"
            style="@style/LoqIn.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/schedules_location_map_picker_search_action"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutMapLocationQuery" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mapFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:minHeight="280dp"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            app:layout_constraintBottom_toTopOf="@id/tvMapPickerSelection"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnMapPickerSearch" />

        <TextView
            android:id="@+id/tvMapPickerSelection"
            android:textAppearance="@style/TextAppearance.LoqIn.RowSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/schedules_location_map_picker_no_selection"
            app:layout_constraintBottom_toTopOf="@id/btnMapPickerUseSelection"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMapPickerUseSelection"
            style="@style/LoqIn.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ok"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
