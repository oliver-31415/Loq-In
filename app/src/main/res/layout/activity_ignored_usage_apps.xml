<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Pinned topbar: its own static bar, never scrolls. Kept out of the
         collapsing AppBarLayout below because AppBarLayout ends its collapse
         range at the first static child. -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/LoqIn.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="@string/ignored_usage_apps_title">

            <ImageButton
                android:id="@+id/btnHiddenAppsInfo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ignored_usage_apps_info"
                android:src="@drawable/info_24"
                app:tint="?attr/colorOnSurface" />
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Collapsing header: the section card is the FIRST child so it gets a
             real collapse range and scrolls 1:1; search + chips + count have no
             flags so they pin beneath it. -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/foqos_bg"
            app:liftOnScroll="false">

            <!-- Section options: scrolls away with the grid. Same stack as App rules,
                 Website rules and In-app rules: mode card, search, filter chips. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHiddenSection"
                style="@style/LoqIn.PageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_margin"
                android:layout_marginTop="@dimen/page_top_padding"
                android:layout_marginEnd="@dimen/page_margin"
                app:layout_scrollFlags="scroll">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleHiddenAppsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHiddenAppPickers"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hidden_apps_tab_pickers" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHiddenUsageInsights"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hidden_apps_tab_usage" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- 8dp card padding + 12dp = the 20dp text inset of a list row -->
                    <TextView
                        android:id="@+id/tvSectionDescription"
                        style="@style/LoqIn.RowSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sticky filters: no scroll flags, so search + chips + count pin
                 below the toolbar once the section card scrolls away -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/block_gap"
                android:paddingBottom="4dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/searchBox"
                    style="@style/LoqIn.SearchField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_margin"
                    android:layout_marginEnd="@dimen/page_margin"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ignored_usage_apps_search_hint"
                        android:inputType="text"
                        android:imeOptions="actionSearch" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Suggested / All / Hidden filter chips: scroll edge to edge, start on the page gutter -->
                <HorizontalScrollView
                    android:id="@+id/filterScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingStart="@dimen/page_margin"
                    android:paddingEnd="@dimen/page_margin"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipFilters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true"
                        app:singleSelection="false" />
                </HorizontalScrollView>

                <!-- Bulk actions: only while a search or filter is active -->
                <LinearLayout
                    android:id="@+id/bulkBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_margin"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="@dimen/page_margin"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectAll"
                        style="@style/LoqIn.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/hidden_apps_select_all"
                        app:icon="@drawable/check_circle_24"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearAll"
                        style="@style/LoqIn.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/hidden_apps_clear_all"
                        app:icon="@drawable/close_24"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <!-- Count: inset like a section header / the search text -->
                <TextView
                    android:id="@+id/tvIgnoredCount"
                    style="@style/LoqIn.RowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_margin"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="@dimen/page_margin"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Content: tiles carry half the tile gap as margin (4dp), so 12dp padding
             puts the outer tile edges on the 16dp page gutter -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvIgnoredUsageApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="@dimen/page_bottom_padding"
            android:clipToPadding="false"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Pinned bottom action: outside the scrolling container so it can never
         scroll away with the grid -->
    <LinearLayout
        style="@style/LoqIn.BottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveIgnoredApps"
            style="@style/LoqIn.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
