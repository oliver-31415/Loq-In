<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Topbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/LoqIn.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="@string/blocked_inbox_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content: controls on the page gutter, then the list (same gutter via LoqIn.PageContent). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.oliver.loqin.ui.widgets.ListGroupLayout
            android:id="@+id/cardControls"
            style="@style/LoqIn.ListGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="@dimen/page_top_padding"
            android:layout_marginEnd="@dimen/page_margin">

            <LinearLayout
                style="@style/LoqIn.ListRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    style="@style/LoqIn.RowText.NoIcon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/LoqIn.RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_show_session_missed_notifications_title" />

                    <TextView
                        android:id="@+id/tvSessionMissedSummary"
                        style="@style/LoqIn.RowSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_show_session_missed_notifications_summary" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSessionMissed"
                    style="@style/LoqIn.RowSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/pref_show_session_missed_notifications_title" />
            </LinearLayout>
        </com.oliver.loqin.ui.widgets.ListGroupLayout>

        <!-- Filter and sort, stacked so each label has the full width (German labels are long). -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFilterApp"
            style="@style/LoqIn.DropdownLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="@dimen/block_gap"
            android:layout_marginEnd="@dimen/page_margin"
            android:hint="@string/blocked_inbox_filter_app"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdownFilterApp"
                style="@style/LoqIn.DropdownText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@null"
                android:importantForAutofill="no"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSort"
            style="@style/LoqIn.DropdownLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/page_margin"
            android:hint="@string/blocked_inbox_sort_title"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdownSort"
                style="@style/LoqIn.DropdownText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@null"
                android:importantForAutofill="no"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.oliver.loqin.ui.widgets.EmptyStateView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="@dimen/section_gap"
            android:layout_marginEnd="@dimen/page_margin"
            android:visibility="gone"
            app:emptyBody="@string/blocked_inbox_empty_body"
            app:emptyIcon="@drawable/notifications_24"
            app:emptyTitle="@string/blocked_inbox_empty_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerInbox"
            style="@style/LoqIn.PageContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
