<?xml version="1.0" encoding="utf-8"?>
<!--
  Website usage detail, same layout as the app detail: range bar under the top bar, summary card,
  the daily limit as a grouped row, then the chart card.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/LoqIn.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        style="@style/LoqIn.PageContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Range bar: same control as every statistics page (StatsPageUi.rangeBar). -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/block_gap"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRangeToday"
                    style="@style/LoqIn.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/usage_range_today" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRangeWeek"
                    style="@style/LoqIn.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/usage_range_week" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRangeMonth"
                    style="@style/LoqIn.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/usage_range_month" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRangeYear"
                    style="@style/LoqIn.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/usage_range_year" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRangeCustom"
                    style="@style/LoqIn.Segment"
                    android:layout_width="@dimen/stats_calendar_segment_width"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:contentDescription="@string/activity_history_range_custom"
                    android:text=""
                    app:icon="@drawable/calendar_month_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Same as stats_custom_range_row.xml. -->
            <LinearLayout
                android:id="@+id/customRangeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/block_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/row_padding_start"
                android:visibility="gone">

                <TextView
                    android:id="@+id/customRangeValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.LoqIn.RowValue" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearCustomRange"
                    style="@style/LoqIn.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/row_trailing_gap"
                    android:text="@string/stats_range_clear" />
            </LinearLayout>

            <!-- Summary card: domain, then label / hero total for the range. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/LoqIn.PageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/page_card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/iconBackdrop"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_roundel_accent">

                            <ImageView
                                style="@style/LoqIn.RowIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/language_24" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/row_icon_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/detailTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textAppearance="@style/TextAppearance.LoqIn.RowTitle" />

                            <TextView
                                android:id="@+id/detailSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnEditLimits"
                            android:layout_width="@dimen/touch_target"
                            android:layout_height="@dimen/touch_target"
                            android:layout_marginStart="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/edit_limits"
                            android:padding="12dp"
                            app:srcCompat="@drawable/tune_24"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <ImageButton
                            android:id="@+id/btnManageBlocking"
                            android:layout_width="@dimen/touch_target"
                            android:layout_height="@dimen/touch_target"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/website_manage_blocking"
                            android:padding="12dp"
                            app:srcCompat="@drawable/security_24"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/rangeTotalCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />

                    <TextView
                        android:id="@+id/rangeTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.LoqIn.HeroValue" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Daily limit -->
            <TextView
                style="@style/LoqIn.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/usage_details_limits_section" />

            <com.oliver.loqin.ui.widgets.ListGroupLayout
                style="@style/LoqIn.ListGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/cardDailyLimit"
                    style="@style/LoqIn.ListRow.OneLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/LoqIn.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/timer_24" />

                    <LinearLayout
                        style="@style/LoqIn.RowText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/LoqIn.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/limit_time_action" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDailyLimitValue"
                        style="@style/LoqIn.RowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_limit" />

                    <ImageView
                        style="@style/LoqIn.RowChevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null" />
                </LinearLayout>
            </com.oliver.loqin.ui.widgets.ListGroupLayout>

            <TextView
                android:id="@+id/tvLimitHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="@dimen/row_padding_start"
                android:paddingEnd="@dimen/row_padding_start"
                android:text="@string/limits_quick_edit_hint"
                android:textAppearance="@style/TextAppearance.LoqIn.RowSummary"
                android:visibility="gone" />

            <!-- Usage over time -->
            <TextView
                style="@style/LoqIn.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/usage_details_activity_section" />

            <com.google.android.material.card.MaterialCardView
                style="@style/LoqIn.PageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/page_card_padding">

                    <TextView
                        android:id="@+id/chartSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />

                    <com.oliver.loqin.ui.widgets.UsageDetailChartView
                        android:id="@+id/chart"
                        android:layout_width="match_parent"
                        android:layout_height="190dp"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Profile indicator (kept for logic compat, hidden) -->
            <TextView
                android:id="@+id/tvProfileIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
