<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="TooManyViews">

    <!-- Topbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/LoqIn.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="@string/account_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        style="@style/LoqIn.PageContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Activity & history -->
            <TextView
                style="@style/LoqIn.SectionHeader.First"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/account_section_activity_history" />

            <com.oliver.loqin.ui.widgets.ListGroupLayout
                style="@style/LoqIn.ListGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Loq In stats -->
                <LinearLayout
                    android:id="@+id/cardAccountOverview"
                    style="@style/LoqIn.ListRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/LoqIn.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/dashboard_24" />

                    <LinearLayout
                        style="@style/LoqIn.RowText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/LoqIn.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/loqin_overview_title" />

                        <TextView
                            style="@style/LoqIn.RowSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/account_overview_summary" />
                    </LinearLayout>

                    <ImageView
                        style="@style/LoqIn.RowChevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null" />
                </LinearLayout>


                <!-- Screen unlocks -->
                <LinearLayout
                    android:id="@+id/cardAccountScreenUnlocks"
                    style="@style/LoqIn.ListRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/LoqIn.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/lock_open_24" />

                    <LinearLayout
                        style="@style/LoqIn.RowText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/LoqIn.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/activity_entry_screen_unlocks" />

                        <TextView
                            style="@style/LoqIn.RowSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/activity_entry_screen_unlocks_summary" />
                    </LinearLayout>

                    <ImageView
                        style="@style/LoqIn.RowChevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null" />
                </LinearLayout>


                <!-- Blocked notifications -->
                <LinearLayout
                    android:id="@+id/cardAccountBlockedNotifications"
                    style="@style/LoqIn.ListRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivAccountBlockedNotificationsIcon"
                        style="@style/LoqIn.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/notifications_24" />

                    <LinearLayout
                        style="@style/LoqIn.RowText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/LoqIn.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/blocked_inbox_title" />

                        <TextView
                            style="@style/LoqIn.RowSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/activity_blocked_notifications_summary" />
                    </LinearLayout>

                    <ImageView
                        style="@style/LoqIn.RowChevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null" />
                </LinearLayout>
            </com.oliver.loqin.ui.widgets.ListGroupLayout>

            <!-- Your data -->
            <TextView
                style="@style/LoqIn.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/account_section_your_data" />

            <com.oliver.loqin.ui.widgets.ListGroupLayout
                style="@style/LoqIn.ListGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Privacy & data -->
                <LinearLayout
                    android:id="@+id/cardAccountPrivacy"
                    style="@style/LoqIn.ListRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/LoqIn.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/security_24" />

                    <LinearLayout
                        style="@style/LoqIn.RowText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/LoqIn.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/privacy_report_title" />

                        <TextView
                            style="@style/LoqIn.RowSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/privacy_report_settings_summary" />
                    </LinearLayout>

                    <ImageView
                        style="@style/LoqIn.RowChevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null" />
                </LinearLayout>
            </com.oliver.loqin.ui.widgets.ListGroupLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
