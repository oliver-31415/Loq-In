<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Topbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/LoqIn.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="@string/protection_changes_title">

            <ImageButton
                android:id="@+id/btnProtectionChangesInfo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/protection_changes_info_title"
                android:src="@drawable/info_24"
                app:tint="?attr/colorOnSurface" />
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content -->
    <ScrollView
        android:id="@+id/protectionChangesScroll"
        style="@style/LoqIn.PageContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Change delay -->
            <TextView
                style="@style/LoqIn.SectionHeader.First"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protection_changes_section_delay" />

            <com.oliver.loqin.ui.widgets.ListGroupLayout
                style="@style/LoqIn.ListGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/rowChangeDelay"
                    style="@style/LoqIn.ListRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/LoqIn.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/schedule_24" />

                    <LinearLayout
                        style="@style/LoqIn.RowText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/LoqIn.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/protection_change_delay_title" />

                        <TextView
                            android:id="@+id/tvChangeDelaySummary"
                            style="@style/LoqIn.RowSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvChangeDelayValue"
                        style="@style/LoqIn.RowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageView
                        style="@style/LoqIn.RowChevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/open" />
                </LinearLayout>
            </com.oliver.loqin.ui.widgets.ListGroupLayout>

            <!-- Pending changes -->
            <TextView
                style="@style/LoqIn.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protection_pending_changes_title" />

            <!-- Shown instead of the card below while nothing is pending. -->
            <com.oliver.loqin.ui.widgets.EmptyStateView
                android:id="@+id/tvPendingEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:emptyIcon="@drawable/schedule_24"
                app:emptyTitle="@string/protection_pending_changes_none" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPendingChanges"
                style="@style/LoqIn.PageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/pendingChangesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/pendingFooter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/tvPendingSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/protection_pending_changes_open"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/pendingActionsRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDiscardAllPending"
                                style="@style/LoqIn.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/protection_pending_cancel_action" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnApplyAllPending"
                                style="@style/LoqIn.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/protection_pending_apply_all_action" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
