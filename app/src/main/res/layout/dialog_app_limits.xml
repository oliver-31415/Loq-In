<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <!-- Contextual header: app icon + name + profile -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivAppLimitIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppLimitTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppLimitSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="4"
                android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Live sentence summary -->
    <com.google.android.material.card.MaterialCardView
        style="@style/LoqIn.PageCard.OnSurface"
        android:id="@+id/cardAppLimitSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_gap">

        <TextView
            android:id="@+id/tvAppLimitSentence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:padding="16dp"
            android:textAppearance="@style/TextAppearance.LoqIn.RowSummary"
            android:textColor="?attr/colorOnSurface" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 1. Daily screen time -->
    <com.google.android.material.card.MaterialCardView
        style="@style/LoqIn.PageCard.OnSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_gap">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/LoqIn.RowIcon"
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_marginEnd="@dimen/row_icon_gap"
                    android:contentDescription="@null"
                    android:src="@drawable/schedule_24" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_limit_section_time"
                        android:textAppearance="@style/TextAppearance.LoqIn.RowTitle" />

                    <TextView
                        android:id="@+id/tvAppLimitTimeSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_limit_time_subtitle"
                        android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAppLimitTime"
                    style="@style/LoqIn.RowSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowLimitTimeControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTimeMinus"
                        style="@style/LoqIn.TonalButton"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:minWidth="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:contentDescription="@string/app_limit_a11y_time_decrease"
                        android:text=""
                        app:backgroundTint="@color/foqos_surface"
                        app:icon="@drawable/remove_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="?attr/colorOnSurface" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAppLimitTime"
                        style="@style/LoqIn.SheetField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:layout_weight="1"
                        android:hint="@string/app_limit_time_hint"
                        app:suffixText="@string/app_limit_unit_minutes">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAppLimitTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTimePlus"
                        style="@style/LoqIn.TonalButton"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:minWidth="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:contentDescription="@string/app_limit_a11y_time_increase"
                        android:text=""
                        app:backgroundTint="@color/foqos_surface"
                        app:icon="@drawable/add_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pillTime15"
                        style="@style/LoqIn.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/app_limit_pill_15m"
                        android:minWidth="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="?attr/colorOnSurface"
                        app:backgroundTint="@color/foqos_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pillTime30"
                        style="@style/LoqIn.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:text="@string/app_limit_pill_30m"
                        android:minWidth="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="?attr/colorOnSurface"
                        app:backgroundTint="@color/foqos_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pillTime60"
                        style="@style/LoqIn.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:text="@string/app_limit_pill_1h"
                        android:minWidth="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="?attr/colorOnSurface"
                        app:backgroundTint="@color/foqos_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pillTime120"
                        style="@style/LoqIn.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/app_limit_pill_2h"
                        android:minWidth="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="?attr/colorOnSurface"
                        app:backgroundTint="@color/foqos_surface" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/app_limit_reset_label"
                    android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />

                <FrameLayout
                    android:id="@+id/containerAppLimitReset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleAppLimitReset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAppLimitResetDaily"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_limit_reset_daily" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAppLimitResetProtection"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_limit_reset_protection" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvAppLimitResetHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 2. App opens -->
    <com.google.android.material.card.MaterialCardView
        style="@style/LoqIn.PageCard.OnSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_gap">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/LoqIn.RowIcon"
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_marginEnd="@dimen/row_icon_gap"
                    android:contentDescription="@null"
                    android:src="@drawable/open_in_new_24" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAppLimitOpensTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_limit_section_opens"
                        android:textAppearance="@style/TextAppearance.LoqIn.RowTitle" />

                    <TextView
                        android:id="@+id/tvAppLimitOpensSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_limit_opens_subtitle"
                        android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAppLimitOpens"
                    style="@style/LoqIn.RowSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowLimitOpensControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpensMinus"
                    style="@style/LoqIn.TonalButton"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:contentDescription="@string/app_limit_a11y_opens_decrease"
                    android:text=""
                    app:backgroundTint="@color/foqos_surface"
                    app:icon="@drawable/remove_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAppLimitAttempts"
                    style="@style/LoqIn.SheetField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:hint="@string/app_limit_attempts_hint"
                    app:suffixText="@string/app_limit_unit_opens">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAppLimitAttempts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpensPlus"
                    style="@style/LoqIn.TonalButton"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:contentDescription="@string/app_limit_a11y_opens_increase"
                    android:text=""
                    app:backgroundTint="@color/foqos_surface"
                    app:icon="@drawable/add_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. Single session cap -->
    <com.google.android.material.card.MaterialCardView
        style="@style/LoqIn.PageCard.OnSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_gap">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/LoqIn.RowIcon"
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_marginEnd="@dimen/row_icon_gap"
                    android:contentDescription="@null"
                    android:src="@drawable/timer_24" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_limit_section_visit"
                        android:textAppearance="@style/TextAppearance.LoqIn.RowTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_limit_visit_subtitle"
                        android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAppLimitVisit"
                    style="@style/LoqIn.RowSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowLimitVisitControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVisitMinus"
                        style="@style/LoqIn.TonalButton"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:minWidth="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:contentDescription="@string/app_limit_a11y_visit_decrease"
                        android:text=""
                        app:backgroundTint="@color/foqos_surface"
                        app:icon="@drawable/remove_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="?attr/colorOnSurface" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAppLimitPerVisit"
                        style="@style/LoqIn.SheetField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:layout_weight="1"
                        android:hint="@string/app_limit_per_visit_hint"
                        app:suffixText="@string/app_limit_unit_minutes">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAppLimitPerVisit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVisitPlus"
                        style="@style/LoqIn.TonalButton"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:minWidth="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:contentDescription="@string/app_limit_a11y_visit_increase"
                        android:text=""
                        app:backgroundTint="@color/foqos_surface"
                        app:icon="@drawable/add_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="?attr/colorOnSurface" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVisitWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/LoqIn.RowStatus.Warning"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/LoqIn.PageCard.OnSurface"
        android:id="@+id/cardAppPause"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_gap"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_min_height_one_line"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                style="@style/LoqIn.RowIcon"
                android:layout_width="@dimen/row_icon_size"
                android:layout_height="@dimen/row_icon_size"
                android:layout_marginEnd="@dimen/row_icon_gap"
                android:contentDescription="@null"
                android:src="@drawable/timer_24" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_limit_section_pause"
                    android:textAppearance="@style/TextAppearance.LoqIn.RowTitle" />

                <TextView
                    android:id="@+id/tvAppPauseSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swAppPause"
                style="@style/LoqIn.RowSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
