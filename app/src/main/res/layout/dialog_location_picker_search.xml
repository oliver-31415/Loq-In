<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:textAppearance="?attr/textAppearanceBody2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/schedules_location_picker_body" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutLocationQuery"
        style="@style/LoqIn.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/schedules_location_picker_hint"
        app:startIconDrawable="@drawable/search_24"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputLocationQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="textPostalAddress|textCapSentences"
            android:maxLines="1"
            android:minHeight="52dp"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLocationSearch"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:minHeight="44dp"
        app:strokeWidth="0dp"
        android:text="@string/schedules_location_map_picker_search_action"
        app:icon="@drawable/search_24"
        app:iconGravity="textStart" />

    <ProgressBar
        android:id="@+id/progressLocationSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvLocationSearchStatus"
        android:textAppearance="?attr/textAppearanceBody2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone"
        tools:text="No matching locations found"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLocationResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:nestedScrollingEnabled="false"
        android:visibility="gone"
        tools:itemCount="3"
        tools:listitem="@layout/item_location_search_result"
        tools:visibility="visible" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@color/foqos_outline_variant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickerUseCurrentLocation"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:minHeight="44dp"
        app:strokeWidth="0dp"
        android:text="@string/schedules_location_pick_current"
        app:icon="@drawable/location_on_24"
        app:iconGravity="textStart" />
</LinearLayout>
