<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Topbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/foqos_bg"
        android:fitsSystemWindows="true"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/LoqIn.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="@string/schedules_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content: everything on the 16dp page gutter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/page_top_padding"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <include
            android:id="@+id/scheduleSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            layout="@layout/view_rule_summary" />

        <include
            android:id="@+id/cardScheduleHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="@dimen/block_gap"
            android:layout_marginEnd="@dimen/page_margin"
            android:visibility="gone"
            layout="@layout/view_status_card" />

        <!-- No schedules yet: replaces the summary card and the list; its button is the page's
             one action -->
        <com.oliver.loqin.ui.widgets.EmptyStateView
            android:id="@+id/emptySchedules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="@dimen/block_gap"
            android:layout_marginEnd="@dimen/page_margin"
            android:visibility="gone"
            app:emptyIcon="@drawable/schedule_24"
            app:emptyTitle="@string/schedule_tile_summary_empty"
            app:emptyActionText="@string/schedule_tile_add_label" />

        <!-- 48dp header row (holds Reorder): 8dp + its centring = the 24dp section gap -->
        <include
            android:id="@+id/headerSchedules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/page_margin"
            layout="@layout/item_website_section_header" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSchedules"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="120dp"
            android:clipToPadding="false" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
