<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Topbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/LoqIn.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="@string/statistics_usage_title">

            <ImageButton
                android:id="@+id/btnStatsSortFilter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/stats_sort_filter"
                android:src="@drawable/tune_24"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnStatsInfo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/statistics_usage_info_title"
                android:src="@drawable/info_24"
                app:tint="?attr/colorOnSurface" />
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        style="@style/LoqIn.PageContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statsPageSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/block_gap"
                android:paddingStart="@dimen/row_padding_start"
                android:paddingEnd="@dimen/row_padding_start"
                android:text="@string/statistics_usage_subtitle_web"
                android:textAppearance="@style/TextAppearance.LoqIn.RowSummary"
                android:visibility="gone" />

            <!-- Range bar: same control as every statistics page (StatsPageUi.rangeBar). -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/chipGroupRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/block_gap"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipToday"
                    style="@style/LoqIn.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/stats_range_today" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipWeek"
                    style="@style/LoqIn.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/stats_range_week" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipMonth"
                    style="@style/LoqIn.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/stats_range_month" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipYear"
                    style="@style/LoqIn.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/stats_range_year" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipCustom"
                    style="@style/LoqIn.Segment"
                    android:layout_width="@dimen/stats_calendar_segment_width"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:contentDescription="@string/activity_history_range_custom"
                    android:text=""
                    app:icon="@drawable/calendar_month_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Same as stats_custom_range_row.xml. -->
            <LinearLayout
                android:id="@+id/customRangeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/block_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/row_padding_start"
                android:visibility="gone">

                <TextView
                    android:id="@+id/customRangeValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.LoqIn.RowValue" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearCustomRange"
                    style="@style/LoqIn.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/row_trailing_gap"
                    android:text="@string/stats_range_clear" />
            </LinearLayout>

            <!-- Summary card: label, hero value, comparison line (same anatomy as stats_summary_card.xml). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUsageTotal"
                style="@style/LoqIn.PageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/page_card_padding">

                    <TextView
                        android:id="@+id/totalLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/usage_total_screen_time"
                        android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />

                    <TextView
                        android:id="@+id/totalTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.LoqIn.HeroValue" />

                    <TextView
                        android:id="@+id/totalComparison"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.LoqIn.RowSummary"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApps"
                    style="@style/LoqIn.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/usage_apps_tab" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWeb"
                    style="@style/LoqIn.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/usage_websites_tab" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/rowTapHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/block_gap"
                android:paddingStart="@dimen/row_padding_start"
                android:paddingEnd="@dimen/row_padding_start"
                android:text="@string/usage_row_tap_hint"
                android:textAppearance="@style/TextAppearance.LoqIn.RowSummary" />

            <TextView
                android:id="@+id/permHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/block_gap"
                android:paddingStart="@dimen/row_padding_start"
                android:paddingEnd="@dimen/row_padding_start"
                android:text="@string/usage_access_needed_desc"
                android:textAppearance="@style/TextAppearance.LoqIn.RowSummary"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSettings"
                style="@style/LoqIn.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/block_gap"
                android:text="@string/usage_open_settings"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <com.oliver.loqin.ui.widgets.EmptyStateView
                android:id="@+id/webPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/block_gap"
                android:visibility="gone"
                app:emptyIcon="@drawable/bar_chart_24"
                app:emptyTitle="@string/usage_chart_no_data" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
