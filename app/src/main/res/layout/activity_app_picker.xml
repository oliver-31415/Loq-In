<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Pinned topbar: its own static bar, never scrolls. Kept out of the
         collapsing AppBarLayout below because AppBarLayout ends its collapse
         range at the first static child. -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/foqos_bg"
        android:fitsSystemWindows="true"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/LoqIn.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="@string/app_rules_title">

            <ImageButton
                android:id="@+id/btnAppRulesInfo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_rules_info_title"
                android:src="@drawable/info_24"
                app:tint="?attr/colorOnSurface" />
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Collapsing header: the rule card is the FIRST child so it gets a real
             collapse range and scrolls 1:1; search + chips + bulk actions have no
             flags so they pin beneath it. Same stack as Website rules, In-app rules
             and Hidden apps: mode card, search, filter chips. -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/foqos_bg"
            app:liftOnScroll="false">

            <!-- Rule options: scrolls away with the grid -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRuleSettings"
                style="@style/LoqIn.PageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_margin"
                android:layout_marginTop="@dimen/page_top_padding"
                android:layout_marginEnd="@dimen/page_margin"
                app:layout_scrollFlags="scroll">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleProfileRuleMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBlockSelectedMode"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/profile_rule_mode_block" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAllowSelectedMode"
                            style="@style/LoqIn.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/profile_rule_mode_allow" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- 8dp card padding + 12dp = the 20dp text inset of a list row -->
                    <TextView
                        android:id="@+id/tvAppRuleModeSummary"
                        style="@style/LoqIn.RowSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/cbAutoBlockNewApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/app_picker_auto_block_new_apps_title"
                        android:textAppearance="@style/TextAppearance.LoqIn.RowSummary"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvAutoBlockNewAppsSummary"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        android:text="@string/app_picker_auto_block_new_apps_summary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sticky filters: no scroll flags, so search + chips + bulk actions pin
                 below the toolbar once the rule card scrolls away -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/block_gap"
                android:paddingBottom="4dp">

                <!-- Search -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/searchBox"
                    style="@style/LoqIn.SearchField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_margin"
                    android:layout_marginEnd="@dimen/page_margin"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/search_apps"
                        android:inputType="text"
                        android:imeOptions="actionSearch" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Category filter chips: scroll edge to edge, start on the page gutter -->
                <HorizontalScrollView
                    android:id="@+id/categoryScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingStart="@dimen/page_margin"
                    android:paddingEnd="@dimen/page_margin"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true"
                        app:singleSelection="false" />
                </HorizontalScrollView>

                <!-- Bulk actions: only while a search or category filter is active -->
                <LinearLayout
                    android:id="@+id/bulkBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_margin"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="@dimen/page_margin"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectAll"
                        style="@style/LoqIn.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/app_picker_select_all"
                        app:icon="@drawable/check_circle_24"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearAll"
                        style="@style/LoqIn.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/app_picker_clear_all"
                        app:icon="@drawable/close_24"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Content: tiles carry half the tile gap as margin (4dp), so 12dp padding
             puts the outer tile edges on the 16dp page gutter -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="@dimen/page_bottom_padding"
            android:clipToPadding="false"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Pinned bottom action: outside the scrolling container so it can never
         scroll away with the grid -->
    <LinearLayout
        style="@style/LoqIn.BottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/LoqIn.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
