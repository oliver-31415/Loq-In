<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetBlockedRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_card_bg"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/widgetBlockedHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:text="@string/widget_blocked_notifications_name"
        android:textColor="@color/foqos_on_surface"
        android:textSize="14sp"
        android:textStyle="bold"
        android:drawablePadding="8dp" />

    <TextView
        android:id="@+id/widgetBlockedEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/blocked_inbox_empty"
        android:textColor="@color/foqos_on_surface_variant"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widgetBlockedRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="8dp"
        android:background="@drawable/widget_tile_bg"
        android:textColor="@color/foqos_on_surface"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/widgetBlockedRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:padding="8dp"
        android:background="@drawable/widget_tile_bg"
        android:textColor="@color/foqos_on_surface"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/widgetBlockedRow3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:padding="8dp"
        android:background="@drawable/widget_tile_bg"
        android:textColor="@color/foqos_on_surface"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/widgetBlockedRow4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:padding="8dp"
        android:background="@drawable/widget_tile_bg"
        android:textColor="@color/foqos_on_surface"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/widgetBlockedRow5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:padding="8dp"
        android:background="@drawable/widget_tile_bg"
        android:textColor="@color/foqos_on_surface"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp" />
</LinearLayout>
