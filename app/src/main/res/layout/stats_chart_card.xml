<?xml version="1.0" encoding="utf-8"?>
<!--
    A chart or content card on a statistics page (StatsPageUi.chartCard): page card, 20dp padding,
    title in the row-title style, optional muted summary, then the content added from code.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LoqIn.PageCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/statsCardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_card_padding">

        <TextView
            android:id="@+id/statsCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LoqIn.RowTitle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statsCardSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.LoqIn.RowSummary"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
