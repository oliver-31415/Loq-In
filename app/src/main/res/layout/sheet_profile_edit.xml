<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="22dp"
    android:background="@drawable/sheet_profile_bg">

    <!-- Grab handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_grab_handle" />

    <!-- Title + close: Prominent Profile Name without pen icon, tap to rename -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/rowSheetRename"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/tvSheetProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Work Profile" />

            <TextView
                style="@style/LoqIn.RowSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_sheet_tap_to_rename" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnSheetClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_sheet_close"
            android:clickable="true"
            android:contentDescription="@string/close"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/close_24"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>
    </LinearLayout>

    <!-- Destinations -->
    <com.oliver.loqin.ui.widgets.ListGroupLayout
        style="@style/LoqIn.ListGroup.OnSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/rowSheetApps"
            style="@style/LoqIn.ListRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                style="@style/LoqIn.RowIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/apps_24" />

            <LinearLayout
                style="@style/LoqIn.RowText"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/LoqIn.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_sheet_apps" />

                <TextView
                    style="@style/LoqIn.RowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_sheet_apps_summary" />
            </LinearLayout>

            <ImageView
                style="@style/LoqIn.RowChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSheetWebsites"
            style="@style/LoqIn.ListRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                style="@style/LoqIn.RowIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/language_24" />

            <LinearLayout
                style="@style/LoqIn.RowText"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/LoqIn.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_sheet_websites" />

                <TextView
                    style="@style/LoqIn.RowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_sheet_websites_summary" />
            </LinearLayout>

            <ImageView
                style="@style/LoqIn.RowChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSheetInApp"
            style="@style/LoqIn.ListRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                style="@style/LoqIn.RowIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/layers_24" />

            <LinearLayout
                style="@style/LoqIn.RowText"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/LoqIn.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_sheet_inapp" />

                <TextView
                    style="@style/LoqIn.RowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_sheet_inapp_summary" />
            </LinearLayout>

            <ImageView
                style="@style/LoqIn.RowChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSheetSchedules"
            style="@style/LoqIn.ListRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                style="@style/LoqIn.RowIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/schedule_24" />

            <LinearLayout
                style="@style/LoqIn.RowText"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/LoqIn.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_sheet_schedules" />

                <TextView
                    style="@style/LoqIn.RowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_sheet_schedules_summary" />
            </LinearLayout>

            <ImageView
                style="@style/LoqIn.RowChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSheetTempPauses"
            style="@style/LoqIn.ListRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                style="@style/LoqIn.RowIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/timer_24" />

            <LinearLayout
                style="@style/LoqIn.RowText"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/LoqIn.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_sheet_pauses" />

                <TextView
                    android:id="@+id/tvSheetTempPausesSummary"
                    style="@style/LoqIn.RowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/profile_sheet_pauses_summary" />
            </LinearLayout>

            <ImageView
                style="@style/LoqIn.RowChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />
        </LinearLayout>

    </com.oliver.loqin.ui.widgets.ListGroupLayout>

    <!-- Danger: a group of its own, red icon and label (confirmation follows on tap) -->
    <com.oliver.loqin.ui.widgets.ListGroupLayout
        style="@style/LoqIn.ListGroup.OnSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/rowSheetDelete"
            style="@style/LoqIn.ListRow.OneLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="@dimen/row_icon_size"
                android:layout_height="@dimen/row_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/delete_24"
                app:tint="@color/status_error" />

            <LinearLayout
                style="@style/LoqIn.RowText"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/LoqIn.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_sheet_delete"
                    android:textColor="@color/status_error" />
            </LinearLayout>
        </LinearLayout>
    </com.oliver.loqin.ui.widgets.ListGroupLayout>
</LinearLayout>
