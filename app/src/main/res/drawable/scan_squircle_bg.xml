<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/foqos_surface_container_high" />
            <stroke android:width="1dp" android:color="@color/foqos_outline" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/foqos_surface" />
            <stroke android:width="1dp" android:color="@color/foqos_outline" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
